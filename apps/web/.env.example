# Copy to `.env.local` and fill in. Values starting NEXT_PUBLIC_ are visible in the browser.

# ALYR's own WhatsApp number, digits only with country code. When set, every call to
# action opens a chat with it.
NEXT_PUBLIC_ALYR_WHATSAPP=
# An email address, shown as the second way to reach us. Leave empty and the page says the address is
# being set up, rather than showing one nobody reads.
NEXT_PUBLIC_ALYR_CONTACT_EMAIL=
# ALYR's own public profiles, comma-separated https addresses (LinkedIn, Instagram, X, YouTube,
# Crunchbase). They go into the structured data as sameAs, so add a profile only once it exists
# and carries the same name and description as the site (D-047).
NEXT_PUBLIC_ALYR_SAME_AS=
# Ownership checks for Google Search Console and Bing Webmaster Tools, when verified by HTML tag
# rather than a DNS record. The value is the content="" part of the tag each tool gives you.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# The public address of the site, for canonical links, the sitemap and link previews.
NEXT_PUBLIC_ALYR_SITE_URL=https://alyr.qa
# Where staff sign in, for the footer link. Leave empty where the workspace is not hosted.
NEXT_PUBLIC_ALYR_WORKSPACE_URL=/login
# Where the FastAPI service is (server side only).
ALYR_API_URL=http://127.0.0.1:8000
