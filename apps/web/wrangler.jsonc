// The public ALYR site on Cloudflare: plain files, no server code.
// Build the files with scripts/build-site.sh, then deploy: from GitHub Actions after the
// founder approves (.github/workflows/site-deploy.yml), or by hand from apps/web with
// `pnpm site:deploy` (or `pnpm exec wrangler deploy`). Rollback: docs/runbooks/site-deploy.md.
// The workspace and the API are not hosted here.
{
  "name": "alyr-site",
  "compatibility_date": "2026-10-06",
  // A few lines that redirect every other address to alyr.qa, then serve the files.
  "main": "./site-worker.js",
  // PREVIEW is "on" only for the versions a pull request uploads (they also set REDIRECT
  // "off", so the preview address is not sent to alyr.qa); see site-worker.js.
  "vars": { "REDIRECT": "on", "PREVIEW": "off" },
  // The Worker answers only on the addresses below, not on workers.dev. Each uploaded
  // version still gets its own preview address on workers.dev (a pull request's preview).
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./out-site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // alyr.qa is the main address. The bare alyr.online already had a proxied DNS record,
  // so it is attached as a route, which leaves that record in place.
  "routes": [
    { "pattern": "alyr.qa", "custom_domain": true },
    { "pattern": "www.alyr.qa", "custom_domain": true },
    { "pattern": "alyr.online/*", "zone_name": "alyr.online" },
    { "pattern": "www.alyr.online", "custom_domain": true }
  ]
}
