// The public ALYR site on Cloudflare: plain files, no server code.
// Build the files with scripts/build-site.sh, then `npx wrangler deploy` from apps/web.
// The workspace and the API are not hosted here.
{
  "name": "alyr-site",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./out-site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // The bare domain already has a proxied DNS record in the Cloudflare zone, so the site
  // is attached to it as a route, which leaves that record in place. `www` had no record
  // and is attached as a custom domain, which creates one.
  "routes": [
    { "pattern": "alyr.online/*", "zone_name": "alyr.online" },
    { "pattern": "www.alyr.online", "custom_domain": true }
  ]
}
