{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"app/**/*.test.mjs\"",
    "site:dev": "node ../../scripts/site/dev.mjs",
    "site:build": "bash ../../scripts/build-site.sh",
    "site:serve": "node ../../scripts/site/serve.mjs",
    "site:check": "node ../../scripts/site/check.mjs",
    "site:shots": "node ../../scripts/site/shots.mjs",
    "site:a11y": "node ../../scripts/site/a11y.mjs",
    "site:deploy": "node ../../scripts/site/deploy.mjs",
    "portal:build": "opennextjs-cloudflare build --config wrangler.portal.jsonc",
    "portal:preview": "opennextjs-cloudflare preview --config wrangler.portal.jsonc",
    "portal:deploy": "opennextjs-cloudflare deploy --config wrangler.portal.jsonc"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.1",
    "next": "16.4.5",
    "posthog-js": "1.446.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.14.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.5",
    "jsqr": "1.4.0",
    "lighthouse": "13.6.0",
    "typescript": "^7",
