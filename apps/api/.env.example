# Copy this file to `.env` in the same folder and fill in the values.
# `.env` is ignored by git. Never paste these values into chat or commit them.
# local = developer machine (sign-in optional, simulator on). Anything else is treated as production.
ALYR_ENV=local


# Meta app dashboard > WhatsApp > API Setup: the ID shown under the "From" number.
ALYR_META_PHONE_NUMBER_ID=
# Same page: "WhatsApp Business Account ID".
ALYR_META_WABA_ID=
# Same page: "Generate access token" (lasts about a day), later the system user token.
ALYR_META_ACCESS_TOKEN=
# App dashboard > App settings > Basic > App secret > Show.
ALYR_META_APP_SECRET=
# Any long random phrase you invent. The same phrase goes into Meta's webhook form.
ALYR_META_VERIFY_TOKEN=

# Self-serve onboarding at /start (D-031). Sign-up for new businesses is open on a local
# machine and closed anywhere else unless this is true.
# ALYR_SIGNUP_OPEN=
# Prices, each client's quote and the promise are set in the back office at /ops.

# Order links (ALY-112). A customer's order link carries a token signed with this secret.
# Leave it empty on a developer machine (a built-in value is used). Anywhere else the API
# will not start without 32 or more random characters, kept in the key vault, never here.
# ALYR_LINK_SECRET=
# How many days a customer's link works (default 60).
# ALYR_LINK_DAYS=

# Rate limits per visitor address (ALY-116). Outside a developer machine they count by address only
# once you say where the address is read from; until then only the per-email limit is on.
# Behind Cloudflare: cf-connecting-ip. Behind a proxy that appends to x-forwarded-for: that header,
# with ALYR_CLIENT_IP_PROXIES set to how many proxies of ours add to it (default 1).
# ALYR_CLIENT_IP_HEADER=
# ALYR_CLIENT_IP_PROXIES=1
# Web addresses besides ALYR_PUBLIC_WEB_URL that a signed-in browser may post from, comma separated
# (ALY-118). A change with the session cookie from any other address is refused with 403.
# Local: every localhost port is already allowed.
# ALYR_ALLOWED_ORIGINS=

# Product photos (ALY-103). Leave the R2 values empty to keep photos on local disk under
# .media/, which is right for a developer machine. In production all three are required,
# and the secret goes in the key vault, never here.
# Cloudflare dashboard > R2 > Manage API tokens: a token limited to the bucket alyr-media
# with Object Read and Write gives the key ID and the secret. The account ID is on the
# R2 overview page.
# ALYR_R2_ACCOUNT_ID=
# ALYR_R2_ACCESS_KEY_ID=
# ALYR_R2_SECRET_ACCESS_KEY=
# ALYR_R2_BUCKET=alyr-media
# ALYR_MEDIA_BASE_URL=https://media.alyr.qa
# Per-shop limits (a cap stops new items or photos and never deletes anything).
# ALYR_CATALOG_MAX_ITEMS=1000
# ALYR_CATALOG_MAX_PHOTOS=3000
# The Catalog is on (ALY-113, D-039): a new business starts with its type's own catalog, and
# the three types that exist only for it (ALY-107) are offered; travel and documents have
# none. Set this to false to create new businesses exactly as they were before the Catalog.
# It never changes a business that already exists; the back office switches the Catalog on
# or off for one shop.
# ALYR_CATALOG_FOR_NEW_SHOPS=true

# Clients paying ALYR by card through Paddle (ALY-180, D-074). "paddle" offers it at go-live
# once all three Paddle values are set; empty offers it to nobody. Sandbox until going live.
# The API key and the webhook secret are secrets; the client token is shown in the page.
# ALYR_CARD_BILLING=
# ALYR_PADDLE_ENVIRONMENT=sandbox
# ALYR_PADDLE_API_KEY=
# ALYR_PADDLE_WEBHOOK_SECRET=
# ALYR_PADDLE_CLIENT_TOKEN=
