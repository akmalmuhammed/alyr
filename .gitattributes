# Detect text by default, then keep source and documentation deterministic.
* text=auto

*.js text eol=lf
*.jsx text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.easignore text eol=lf

# Keep binary release assets outside text and EOL conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.apk binary
*.aab binary
*.woff2 binary

supabase/migrations/*.sql text eol=lf
