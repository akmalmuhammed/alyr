# Server-only. Never expose this key through VITE_* variables.
GOOGLE_MAPS_API_KEY=

# Optional configuration.
PORT=8787
ALYR_DATA_FILE=./data/leads.json
ALYR_MARKET_DB=./data/alyr-market.sqlite
WEBSITE_ENRICHMENT_USER_AGENT=ALYR-Prospect-Engine/0.1 (+https://alyr.example)

# Qatar-wide licensed/open-data discovery. Use a responsible identifying user agent.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=ALYR-Prospect-Engine/0.2 (+https://alyr.example; contact=operations@alyr.example)

# External outreach is off by default. Do not enable until permission, templates,
# suppression handling, sender identity and Qatar legal review are complete.
OUTREACH_MODE=disabled

# SMTP (required only for reviewed live email dispatch).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# Meta WhatsApp Cloud API (required only for reviewed, opt-in template dispatch).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
