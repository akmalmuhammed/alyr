{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(docker volume rm*)",
      "Bash(docker system prune*)",
      "Bash(terraform destroy*)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$CLAUDE_CODE_REMOTE\" = \"true\" ]; then bash \"$CLAUDE_PROJECT_DIR/scripts/cloud-setup.sh\" 2>&1 | tail -15; fi",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
