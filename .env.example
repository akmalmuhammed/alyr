# Copy to .env. Never commit .env.

ALYR_ENV=local

# Local services (docker compose)
ALYR_DATABASE_URL=postgresql+asyncpg://alyr:alyr_local@localhost:5432/alyr
ALYR_REDIS_URL=redis://localhost:6379/0

# Meta WhatsApp Cloud API. Leave empty to run on the simulator only.
ALYR_META_APP_SECRET=
ALYR_META_VERIFY_TOKEN=
ALYR_META_ACCESS_TOKEN=
ALYR_META_PHONE_NUMBER_ID=
