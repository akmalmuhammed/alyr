# Copy to apps/api/.env to override. Never commit .env.
# The defaults in apps/api/src/alyr/config.py already match docker-compose.yml.

ALYR_ENV=local

ALYR_DATABASE_URL=postgresql://alyr_app:alyr_app_local@localhost:5432/alyr
ALYR_MIGRATION_URL=postgresql://alyr:alyr_local@localhost:5432/alyr
ALYR_REDIS_URL=redis://localhost:6379/0
ALYR_PUBLIC_WEB_URL=http://localhost:3100

# Meta WhatsApp Cloud API. Leave empty to run on the simulator only.
ALYR_META_APP_SECRET=
ALYR_META_VERIFY_TOKEN=
ALYR_META_ACCESS_TOKEN=
ALYR_META_PHONE_NUMBER_ID=
ALYR_META_WABA_ID=
