{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "heldat-site-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05
  }
}
