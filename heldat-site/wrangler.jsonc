{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "heldat-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-31",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "heldat.app/*",
      "zone_name": "heldat.app"
    },
    {
      "pattern": "www.heldat.app/*",
      "zone_name": "heldat.app"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
