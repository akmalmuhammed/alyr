# Public client configuration only. Never place a Supabase service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy projects may use their public anon JWT instead. Set only one client
# key variable and never use a service-role or sb_secret_ key.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
