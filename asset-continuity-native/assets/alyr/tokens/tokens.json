{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand": {
      "carbon": { "$type": "color", "$value": "#15171A" },
      "volt": { "$type": "color", "$value": "#B7F34A" },
      "mist": { "$type": "color", "$value": "#E9ECEF" },
      "concrete": { "$type": "color", "$value": "#A7ADB5" },
      "black": { "$type": "color", "$value": "#050505" },
      "white": { "$type": "color", "$value": "#FFFFFF" }
    },
    "semantic": {
      "success": { "$type": "color", "$value": "#2D7D46" },
      "warning": { "$type": "color", "$value": "#A96400" },
      "danger": { "$type": "color", "$value": "#B42318" },
      "information": { "$type": "color", "$value": "#1769AA" }
    }
  },
  "dimension": {
    "space": {
      "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
      "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
      "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "6": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
      "8": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
      "12": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
      "16": { "$type": "dimension", "$value": { "value": 64, "unit": "px" } },
      "24": { "$type": "dimension", "$value": { "value": 96, "unit": "px" } }
    },
    "radius": {
      "xs": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
      "sm": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
      "md": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "lg": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
    }
  },
  "typography": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Instrument Sans",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": 430,
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.55
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Instrument Sans",
        "fontSize": { "value": 13, "unit": "px" },
        "fontWeight": 600,
        "letterSpacing": { "value": 0.1, "unit": "px" },
        "lineHeight": 1.2
      }
    }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": { "value": 160, "unit": "ms" } },
      "medium": { "$type": "duration", "$value": { "value": 280, "unit": "ms" } },
      "slow": { "$type": "duration", "$value": { "value": 480, "unit": "ms" } }
    },
    "easeOut": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] }
  }
}

